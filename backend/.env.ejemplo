# Copia estas líneas dentro de tu archivo backend/.env (el que ya tienes).
# URL_BASE_DATOS déjala como la tienes; solo añade CLAVE_SECRETA.

URL_BASE_DATOS=mysql+pymysql://USUARIO:CLAVE@localhost:3306/aprendizaje

# Genera tu propia clave con este comando y pega el resultado aquí:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_SECRETA=pega_aqui_la_clave_generada

# OPCIONAL (modo libre): clave de la API de Anthropic para que las preguntas del PDF las
# redacte una IA. Si no la pones, el modo libre funciona igual con el generador local (sin IA),
# aunque con preguntas más sencillas. Se crea en https://console.anthropic.com
# CLAVE_ANTHROPIC=sk-ant-...
# Modelo a usar (opcional; por defecto claude-sonnet-5-5)
# MODELO_IA=claude-sonnet-5-5
